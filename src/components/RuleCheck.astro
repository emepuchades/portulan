---
interface Props {
  rule: string;
}
const { rule } = Astro.props;
---

<label class="rule-check" data-rule={rule}>
  <input type="checkbox" class="rule-checkbox" />
  <span><slot /></span>
</label>

<script>
  function store() { return (window as any).portulan; }

  function paint() {
    document.querySelectorAll<HTMLLabelElement>('.rule-check').forEach(label => {
      const checkbox = label.querySelector<HTMLInputElement>('.rule-checkbox')!;
      const on = store().isActive(label.dataset.rule!);
      checkbox.checked = on;
      label.classList.toggle('checked', on);
    });
  }

  document.querySelectorAll<HTMLLabelElement>('.rule-check').forEach(label => {
    const checkbox = label.querySelector<HTMLInputElement>('.rule-checkbox')!;
    checkbox.addEventListener('change', () => {
      store().setActive([label.dataset.rule!], checkbox.checked);
    });
  });

  paint();
  document.addEventListener('portulan:rules-changed', paint);
</script>
