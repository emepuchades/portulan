---
import { getCollection } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  currentId?: string;
  isPrompt?: boolean;
  isRules?: boolean;
}

const { title = 'Portulan', currentId, isPrompt = false, isRules = false } = Astro.props;

const allPosts = await getCollection('posts');
allPosts.sort((a, b) => a.data.order - b.data.order);

const groups: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  const g = post.data.group;
  if (!groups[g]) groups[g] = [];
  groups[g].push(post);
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<nav class="sidebar">
  <div class="sidebar-scroll">

    <div class="brand">
      <span class="brand-mark">⟁</span>
      <span class="brand-name">Portulan</span>
    </div>
    <div class="brand-sub">cómo programo · para Claude</div>

    <!-- APUNTES -->
    <div class="nav-section-label">Apuntes</div>

    {Object.entries(groups).map(([groupName, posts]) => (
      <div class="nav-group">
        <div class="nav-group-title">{groupName}</div>
        {posts.map(post => (
          <a
            class:list={['nav-link', { active: currentId === post.id }]}
            href={`/${post.id}`}
          >
            <span class="nav-dot"></span> {post.data.title}
          </a>
        ))}
      </div>
    ))}

    {['Clean Architecture', 'SOLID y Clean Code', 'Lógica de programación', 'IA']
      .filter(g => !groups[g])
      .map(g => (
        <div class="nav-group">
          <div class="nav-group-title">{g}</div>
        </div>
      ))
    }

    <!-- MI AGENTE -->
    <div class="nav-section-label nav-section-label--spaced">Mi agente</div>

    <div class="nav-group">
      <a class:list={['nav-link nav-link--agent', { active: isRules }]} href="/rules">
        <span class="nav-agent-icon">⊞</span>
        Reglas
        <span class="nav-agent-count zero" id="ruleCount">0</span>
      </a>
      <a class:list={['nav-link nav-link--agent', { active: isPrompt }]} href="/prompt">
        <span class="nav-agent-icon">¶</span>
        Prompt
      </a>
    </div>

    <!-- FLUJO -->
    <div class="sidebar-flow">
      <div class="sidebar-flow-step">
        <span class="flow-num">1</span>
        <span class="flow-text">En cada <strong>apunte</strong>, genera reglas con IA o márcalas a mano</span>
      </div>
      <div class="sidebar-flow-step">
        <span class="flow-num">2</span>
        <span class="flow-text">En <strong>Reglas</strong>, activa las que aplican ahora</span>
      </div>
      <div class="sidebar-flow-step">
        <span class="flow-num">3</span>
        <span class="flow-text">En <strong>Prompt</strong>, sintetiza con IA y descarga tu CLAUDE.md</span>
      </div>
    </div>

  </div>
</nav>

<main class="main">
  <slot />
</main>

<script>
  // Migrate storage key from old name
  const _old = localStorage.getItem('cuaderno:rules');
  if (_old && !localStorage.getItem('portulan:rules')) {
    localStorage.setItem('portulan:rules', _old);
    localStorage.removeItem('cuaderno:rules');
  }

  const badge = document.getElementById('ruleCount');
  if (badge) {
    const raw = JSON.parse(localStorage.getItem('portulan:rules') ?? '[]');
    const count = raw.filter((r: any) => typeof r === 'string' || r.active).length;
    badge.textContent = String(count);
    badge.classList.toggle('zero', count === 0);
  }
</script>

</body>
</html>
