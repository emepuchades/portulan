---
import { getCollection } from 'astro:content';
import { getNoteRules } from '../utils/noteRules';
import '../styles/global.css';

interface Props {
  title?: string;
  currentId?: string;
  isAgent?: boolean;
  isWide?: boolean;
}

const { title = 'Portulan', currentId, isAgent = false, isWide = false } = Astro.props;

const allPosts = await getCollection('posts');
allPosts.sort((a, b) => a.data.order - b.data.order);

const groups: Record<string, typeof allPosts> = {};
for (const post of allPosts) {
  const g = post.data.group;
  if (!groups[g]) groups[g] = [];
  groups[g].push(post);
}

const noteRuleTexts = (await getNoteRules()).map(rule => rule.text);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#1f9c7f">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

<nav class="sidebar">
  <div class="sidebar-scroll">

    <div class="brand">
      <span class="brand-mark">⟁</span>
      <span class="brand-name">Portulan</span>
    </div>
    <div class="brand-sub">cómo programo · para Claude</div>

    <!-- MI AGENTE -->
    <a class:list={['agent-card', { active: isAgent }]} href="/agente">
      <span class="agent-card-eyebrow">Mi agente</span>
      <span class="agent-card-title">Crear CLAUDE.md</span>
      <span class="agent-card-meta">
        <span class="agent-count zero" id="ruleCount">0</span>
        <span id="ruleCountLabel">reglas activas</span>
        <span class="agent-card-arrow" aria-hidden="true">→</span>
      </span>
    </a>

    <!-- APUNTES -->
    <div class="nav-section-label">Apuntes</div>

    {Object.entries(groups).map(([groupName, posts]) => (
      <div class="nav-group">
        <div class="nav-group-title">{groupName}</div>
        {posts.map(post => (
          <a
            class:list={['nav-link', { active: currentId === post.id }]}
            href={`/${post.id}`}
          >
            <span class="nav-dot"></span> {post.data.title}
          </a>
        ))}
      </div>
    ))}

  </div>
</nav>

<main class:list={['main', { 'main--wide': isWide }]}>
  <slot />
</main>

<script is:inline define:vars={{ noteRuleTexts }}>
  window.__portulanNoteRules = noteRuleTexts;

  const _old = localStorage.getItem('cuaderno:rules');
  if (_old && !localStorage.getItem('portulan:rules')) {
    localStorage.setItem('portulan:rules', _old);
    localStorage.removeItem('cuaderno:rules');
  }

  window.__portulanActiveCount = function () {
    const raw = JSON.parse(localStorage.getItem('portulan:rules') ?? '[]');
    const stored = new Map(raw.map(r => typeof r === 'string' ? [r, { active: true }] : [r.text, r]));
    const noteSet = new Set(noteRuleTexts);
    const notesActive = noteRuleTexts.filter(text => { const entry = stored.get(text); return entry ? entry.active : true; }).length;
    const customActive = [...stored.entries()].filter(([text, entry]) => !noteSet.has(text) && entry.active).length;
    return notesActive + customActive;
  };

  window.__portulanPaintBadge = function () {
    const badge = document.getElementById('ruleCount');
    const label = document.getElementById('ruleCountLabel');
    if (!badge) return;
    const count = window.__portulanActiveCount();
    badge.textContent = String(count);
    badge.classList.toggle('zero', count === 0);
    if (label) label.textContent = count === 1 ? 'regla activa' : 'reglas activas';
  };

  window.__portulanPaintBadge();
</script>

</body>
</html>
